citHeader("To cite package 'tuber' in publications use:")

# `meta` is the installed DESCRIPTION, so the version and year always match
# the package being cited.
year <- sub("-.*", "", meta$Date)
version_note <- paste("R package version", meta$Version)
title <- paste0("tuber: ", meta$Title)
url <- "https://gojiplus.github.io/tuber/"

bibentry(
  bibtype = "Manual",
  title   = title,
  author  = c(
    person("Gaurav", "Sood"),
    person("Kate", "Lyons"),
    person("John", "Muschelli")
  ),
  year    = year,
  note    = version_note,
  url     = url,
  textVersion = paste0(
    "Gaurav Sood, Kate Lyons, and John Muschelli (", year, "). ",
    title, ". ", version_note, ". ", url
  )
)
